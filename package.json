{
  "name": "armor-events",
  "version": "1.3.0",
  "description": "The events management library",
  "main": "./dist/armor-events.cjs",
  "module": "./dist/armor-events.mjs",
  "browser": "./dist/armor-events.umd.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/armor-events.mjs",
      "require": "./dist/armor-events.cjs",
      "browser": "./dist/armor-events.umd.js"
    }
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build:types": "tsc --emitDeclarationOnly",
    "build": "npm run clean && npm run build:types && rollup -c",
    "test": "vitest run",
    "check": "npm run test && npm run build && node tests/verify-dist.cjs"
  },
  "files": [
    "dist",
    "README.md",
    "docs"
  ],
  "keywords": [
    "events",
    "armor",
    "armorjs"
  ],
  "author": "Xavier Yin",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hendiko/armor-events.git"
  },
  "devDependencies": {
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.1.4",
    "rollup": "^4.41.1",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3",
    "vitest": "^4.1.8"
  }
}
